# Copia este archivo a .env (que no se commitea) y ajusta los valores.
# Si python-dotenv NO está instalado, el .env no se lee: exporta las variables en la terminal, por ejemplo
#   export MATERA_JWT_SECRET="..."

# Qué adaptador de la tabla de referencia de especies se usa: csv | bd (por defecto: csv)
MATERA_TABLA=csv

# Ruta del CSV de especies (por defecto: infrastructure/especies.csv)
MATERA_CSV=infrastructure/especies.csv

# Ruta del archivo SQLite (por defecto: matera.db)
MATERA_DB=matera.db

# OBLIGATORIA, sin valor por defecto, mínimo 16 caracteres. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MATERA_JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Orígenes permitidos por CORS, separados por comas
MATERA_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
